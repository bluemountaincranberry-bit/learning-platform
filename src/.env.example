APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

# Task 5.6 (docs/architecture/ai-platform-implementation-roadmap.md): hot
# AI caches (AiExplainLexemeService, AI rate-limit counters, TutorAgent
# turns-per-day counter) go through Laravel's default Cache store with no
# store name hardcoded anywhere, so this one value moves all of them onto
# Redis (already running — QUEUE_CONNECTION above already depends on it)
# without touching any of that code. See config/cache.php's "redis" store
# (REDIS_CACHE_DB below, database 1) and ADR-005 for why Redis is the right
# home for this and not for anything durable.
CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
# Distinct logical DBs so cache flushes/inspection never touch queue data
# (config/database.php's redis.default/redis.cache connections).
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
# Override for LAN/mobile development, e.g. http://192.168.1.64:5177.
VITE_DEV_SERVER_ORIGIN=http://localhost:5177

YOUTUBE_TRANSCRIPT_DRIVER=fallback
YOUTUBE_TRANSCRIPT_NODE_BASE_URL=http://browser:3000
YOUTUBE_TRANSCRIPT_NODE_TIMEOUT=45
YOUTUBE_TRANSCRIPT_PYTHON_BASE_URL=http://transcript-python:3001
YOUTUBE_TRANSCRIPT_PYTHON_TIMEOUT=45
YOUTUBE_WEB_BASE_URL=https://www.youtube.com
YOUTUBE_WEB_TIMEOUT=15
YOUTUBE_WEB_USER_AGENT="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 Chrome/131 Safari/537.36"
YOUTUBE_PLAYWRIGHT_BASE_URL=http://browser:3000
YOUTUBE_PLAYWRIGHT_TIMEOUT=60
YOUTUBE_STORAGE_STATE_PATH=/run/secrets/youtube-storage-state.json
YOUTUBE_TRANSCRIPT_LANG=
SUPADATA_API_KEY=
SUPADATA_BASE_URL=https://api.supadata.ai/v1
SUPADATA_TRANSCRIPT_MODE=native
SUPADATA_TRANSCRIPT_TIMEOUT=30
SUPADATA_TRANSCRIPT_POLL_INTERVAL_MS=1000
SUPADATA_TRANSCRIPT_MAX_POLLS=10

# AI (EPIC-AI-FIRST)
AI_FEATURE_ENABLED=false
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
LOCAL_WHISPER_ENABLED=true
LOCAL_WHISPER_BASE_URL=http://whisper:8000/v1
LOCAL_WHISPER_MODEL=Systran/faster-whisper-small
AI_EMBEDDINGS_PROVIDER=openai
AI_EMBEDDINGS_MODEL=text-embedding-3-small
AZURE_SPEECH_ENABLED=false
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
OLLAMA_URL=http://localhost:11434

# AI content analysis (candidate extraction: lexemes + grammar)
AI_ANALYSIS_TRANSLATION_LANGUAGE=ru
AI_ANALYSIS_MAX_TRANSCRIPT_CHARS=8000
AI_ANALYSIS_MATCH_THRESHOLD=0.85
